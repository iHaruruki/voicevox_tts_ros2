<?xml version="1.0"?>
<package format="3">
  <name>audio_generator</name>
  <version>1.0.0</version>
  <description>ROS2 Humble VOICEVOX TTS (memory-only, action-based)</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <!-- CMake ベース -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclpy_action</depend>
  <depend>builtin_interfaces</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>