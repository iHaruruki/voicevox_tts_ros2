<?xml version="1.0"?>
<package format="3">
  <name>voicevox_tts_ros2</name>
  <version>0.0.1</version>
  <description>ROS 2 node that subscribes to a text topic and generates / plays synthesized audio using VOICEVOX.</description>
  <maintainer email="haruki.isono861@gmail.com">Haruki Isono</maintainer>
  <license>Todo</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <depend>voicevox_tts_interfaces_ros2</depend>
  <depend>action_msgs</depend>

  <!-- system package names are environment-dependent. Python deps via pip if必要 -->
  <exec_depend>python3-requests</exec_depend>
  <!-- simpleaudio がOSパッケージに無い場合 pip install simpleaudio -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>